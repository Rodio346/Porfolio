---
import { withBase } from '../lib/withBase';

const professionalUrl = withBase(import.meta.env.BASE_URL, 'professional/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${professionalUrl}`} />
    <link rel="canonical" href={professionalUrl} />
    <title>Vishal Yadav</title>
  </head>
  <body>
    <p>Redirecting to <a href={professionalUrl}>Vishal Yadav — Professional profile</a>&hellip;</p>
    <script is:inline define:vars={{ professionalUrl }}>
      window.location.replace(professionalUrl);
    </script>
  </body>
</html>
